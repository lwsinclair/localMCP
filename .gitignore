local/
dev/
development/

# User-specific configurations
user_configs/
personal/

# Experimental features
experimental/
lab/

# Large files that shouldn't be in repo
*.large
models/
weights/

# Third-party integrations
integrations/local/
plugins/local/

.groupedtimelineinclude
