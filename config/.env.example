# Environment Variables for Universal MCP Host
# Copy this file to .env and fill in your API keys

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODELS=gpt-4,gpt-3.5-turbo,gpt-4-turbo

# Anthropic/Claude Configuration  
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODELS=claude-3-sonnet-20240229,claude-3-haiku-20240307,claude-3-opus-20240229

# Ollama Configuration (for local models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODELS=llama2,codellama,mistral

# General MCP Configuration
MCP_LOG_LEVEL=INFO
MCP_CONFIG_PATH=config/servers.json
MCP_HOST_PORT=8501
MCP_HOST_ADDRESS=localhost

# Security Configuration
MCP_ENABLE_TOOLS=true
MCP_REQUIRE_CONFIRMATION=false
MCP_MAX_TOOL_CALLS_PER_REQUEST=10

# UI Configuration
STREAMLIT_THEME=light
STREAMLIT_SIDEBAR_EXPANDED=true
